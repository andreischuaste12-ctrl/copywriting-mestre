{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copywriter-master.invalid/schemas/brief.schema.json",
  "title": "Copywriter Master trusted brief",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "format": {
      "enum": [
        "ad",
        "email",
        "cta",
        "landing",
        "headlines",
        "offer",
        "script"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "offer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "facts"
      ],
      "additionalProperties": false
    },
    "cta": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accepted_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "action",
        "accepted_phrases"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "item_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_characters_per_item": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_characters": {
          "type": "integer",
          "minimum": 1
        },
        "required_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "forbidden_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "item_count",
        "required_phrases",
        "forbidden_phrases"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "fact",
              "testimonial",
              "scarcity",
              "regulated"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "authorization": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "confirmed",
                  "pending",
                  "not_applicable"
                ]
              },
              "reference": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "reference"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "confirmed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reference": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "source_ids",
          "authorization"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "market": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "category": {
      "enum": [
        "general",
        "health",
        "finance",
        "gambling",
        "politics",
        "children",
        "other_regulated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "language",
    "format",
    "audience",
    "offer",
    "cta",
    "constraints",
    "sources",
    "claims",
    "market",
    "category"
  ],
  "additionalProperties": false
}
