{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "draft": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "brief",
          "draft"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "cases"
  ],
  "additionalProperties": false
}
