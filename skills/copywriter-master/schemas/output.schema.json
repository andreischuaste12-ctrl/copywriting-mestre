{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copywriter-master.invalid/schemas/output.schema.json",
  "title": "Copywriter Master draft output",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "brief_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "format": {
      "enum": [
        "ad",
        "email",
        "cta",
        "landing",
        "headlines",
        "offer",
        "script"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "claim_id",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "text",
          "claims"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "brief_id",
    "language",
    "format",
    "items"
  ],
  "additionalProperties": false
}
